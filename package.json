{
  "name": "hiking-by-transit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "npm run generate:content && npm run generate:catalog",
    "generate:content": "python3 scripts/generate-content.py",
    "generate:catalog": "python3 scripts/generate-trailhead-catalog.py",
    "check:generated": "python3 scripts/generate-content.py --check && python3 scripts/generate-trailhead-catalog.py --check",
    "dev": "npm run build:olmap && vite",
    "build": "npm run build:olmap && npm run build:client && npm run build:ssr && npm run prerender && npm run check:prerender && npm run prepare:cloudflare",
    "build:olmap": "npm --workspace olmap run build",
    "build:client": "tsc -b && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "prepare:cloudflare": "node scripts/prepare-cloudflare-assets.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run build:olmap && python3 scripts/test_trailhead_names.py && vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check:generated && npm run lint && npm run test && npm --workspace olmap run verify && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "olmap": "1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
