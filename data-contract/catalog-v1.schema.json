{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikingbytransit.com/schemas/catalog-v1.schema.json",
  "title": "Hiking by Transit static catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "counts", "trailheads", "hikes", "places"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "counts": { "$ref": "#/$defs/counts" },
    "trailheads": {
      "type": "array",
      "items": { "$ref": "#/$defs/trailhead" }
    },
    "hikes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hike" }
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/$defs/place" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "dateOrNull": {
      "type": ["string", "null"],
      "format": "date"
    },
    "textOrNull": {
      "type": ["string", "null"]
    },
    "urlOrNull": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "nonNegativeNumberOrNull": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "coordinates": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpkg", "content", "gtfsSnapshots"],
      "properties": {
        "gpkg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "gitRevision"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "gitRevision": { "type": "string", "minLength": 7 }
          }
        },
        "gtfsSnapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feedId", "sourceUrl", "serviceAsOfDate"],
            "properties": {
              "feedId": { "$ref": "#/$defs/id" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "serviceAsOfDate": { "$ref": "#/$defs/dateOrNull" }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trailheads", "accessRecords", "hikes", "places"],
      "properties": {
        "trailheads": { "type": "integer", "minimum": 0 },
        "accessRecords": { "type": "integer", "minimum": 0 },
        "hikes": { "type": "integer", "minimum": 0 },
        "places": { "type": "integer", "minimum": 0 }
      }
    },
    "trailhead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "coordinates", "status", "notes", "officialUrl", "accessibilityNotes", "lastVerifiedDate", "placeIds", "hikeIds", "access"],
      "properties": {
        "id": { "type": "string", "pattern": "^TH_[0-9]+$" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "status": { "enum": ["active", "seasonal", "temporarily_closed", "retired", "research"] },
        "notes": { "$ref": "#/$defs/textOrNull" },
        "officialUrl": { "$ref": "#/$defs/urlOrNull" },
        "accessibilityNotes": { "$ref": "#/$defs/textOrNull" },
        "lastVerifiedDate": { "$ref": "#/$defs/dateOrNull" },
        "placeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "hikeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "access": {
          "type": "array",
          "items": { "$ref": "#/$defs/access" }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feedId", "stopId", "stopKey", "stopName", "coordinates", "walkMinutes", "walkSource", "notes", "sourceUrl", "serviceAsOfDate", "arrivals", "routeIds", "reservationRequired", "seasonal", "lastVerifiedDate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "feedId": { "$ref": "#/$defs/id" },
        "stopId": { "type": ["string", "null"] },
        "stopKey": { "type": ["string", "null"] },
        "stopName": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/$defs/coordinates" },
        "walkMinutes": { "$ref": "#/$defs/nonNegativeNumberOrNull" },
        "walkSource": { "enum": ["routed", "estimated", "measured", "unknown"] },
        "notes": { "$ref": "#/$defs/textOrNull" },
        "sourceUrl": { "$ref": "#/$defs/urlOrNull" },
        "serviceAsOfDate": { "$ref": "#/$defs/dateOrNull" },
        "arrivals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekday", "saturday", "sunday"],
          "properties": {
            "weekday": { "$ref": "#/$defs/nonNegativeNumberOrNull" },
            "saturday": { "$ref": "#/$defs/nonNegativeNumberOrNull" },
            "sunday": { "$ref": "#/$defs/nonNegativeNumberOrNull" }
          }
        },
        "routeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reservationRequired": { "type": "boolean" },
        "seasonal": { "type": "boolean" },
        "lastVerifiedDate": { "$ref": "#/$defs/dateOrNull" }
      }
    },
    "hike": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "trailheadIds", "placeIds", "difficulty", "difficultyLabel", "lengthLabel", "tags", "gpx", "image", "blurb", "featured"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "trailheadIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^TH_[0-9]+$" }
        },
        "placeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "difficulty": { "enum": ["easy", "moderate", "hard"] },
        "difficultyLabel": { "type": ["string", "null"] },
        "lengthLabel": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gpx": { "type": ["string", "null"] },
        "image": { "type": ["string", "null"] },
        "blurb": { "type": ["string", "null"] },
        "featured": { "type": "boolean" }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "kind", "parentId", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["state", "region", "subregion", "park", "forest", "recreation_area", "other"] },
        "parentId": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    }
  }
}
